{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,e2e/**,src/**,static/**,dist/**,node_modules/**,docs/**,playwright-report/**,test-results/**}"
    }
  }
}
