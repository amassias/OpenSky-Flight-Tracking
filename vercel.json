{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "rewrites": [
    { "source": "/api/emergencies", "destination": "/api/index" },
    { "source": "/api/health", "destination": "/api/index" },
    { "source": "/api/search-airports", "destination": "/api/index" },
    { "source": "/api/map-airports", "destination": "/api/index" },
    { "source": "/api/airports", "destination": "/api/index" },
    { "source": "/api/fetch-flights", "destination": "/api/index" },
    { "source": "/api/flights", "destination": "/api/index" },
    { "source": "/api/airport-conditions", "destination": "/api/index" },
    { "source": "/api/airport-board", "destination": "/api/index" },
    { "source": "/api/airport-schedule", "destination": "/api/index" },
    { "source": "/api/callsign-lookup", "destination": "/api/index" },
    { "source": "/api/aircraft-history", "destination": "/api/index" },
    { "source": "/api/aircraft-flights", "destination": "/api/index" },
    { "source": "/api/aircraft-lookup", "destination": "/api/index" },
    { "source": "/api/global-snapshot", "destination": "/api/index" },
    { "source": "/api/live-flights", "destination": "/api/index" },
    { "source": "/api/flight-route", "destination": "/api/index" },
    { "source": "/api/aircraft-enrichment", "destination": "/api/index" },
    { "source": "/api/flight-info", "destination": "/api/index" },
    { "source": "/api/track", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=(), payment=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org https://t.plnspttrs.net https://thumb.wikimedia.org https://images.kiwi.com; connect-src 'self' https://api.planespotters.net https://tile.openstreetmap.org; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,e2e/**,src/**,static/**,dist/**,node_modules/**,docs/**,playwright-report/**,test-results/**}"
    }
  }
}
