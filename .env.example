# OpenSky Network API Credentials
# Get your credentials at: https://opensky-network.org/
OPEN_SKY_CLIENT_ID=your_client_id_here
OPEN_SKY_CLIENT_SECRET=your_client_secret_here

# Vercel only: the private proxy lets the server query a full map bounding box
# without exposing OpenSky credentials to the browser.
OPEN_SKY_PROXY_BASE_URL=
OPEN_SKY_PROXY_SECRET=
OPEN_SKY_PROXY_TIMEOUT_SECONDS=10
# If credentials are temporarily rejected, serve current bounding boxes
# anonymously at a quota-safe cadence instead of dropping map coverage.
OPEN_SKY_PROXY_ANONYMOUS_FALLBACK=1

# Optional on-demand route enrichment for selected live aircraft.
SKYTRACE_ROUTE_LOOKUP_ENABLED=1
SKYTRACE_ROUTE_TIMEOUT_SECONDS=4
SKYTRACE_ROUTE_CACHE_SECONDS=300

# Optional Hermes Flight Tracker enrichment. The key stays server-side and is
# queried only when an aircraft is selected; successful records are cached for
# 15 minutes (completed/cancelled flights for 24 hours).
FLIGHTAWARE_AEROAPI_KEY=
SKYTRACE_FLIGHTAWARE_ENABLED=1
FLIGHTAWARE_CACHE_TTL_SECONDS=900
FLIGHTAWARE_STABLE_CACHE_TTL_SECONDS=86400
FLIGHTAWARE_MIN_RETRY_SECONDS=900
FLIGHTAWARE_MIN_INTERVAL_SECONDS=5
FLIGHTAWARE_TIMEOUT_SECONDS=5

# Live map provider tuning. The client reuses a viewport briefly to avoid
# rate-limit bursts. On Vercel, OpenSky receives the complete viewport through
# the private proxy; the public ADS-B provider remains the outage fallback.
SKYTRACE_LIVE_CACHE_SECONDS=15
SKYTRACE_LIVE_STALE_SECONDS=90
SKYTRACE_LIVE_MAX_RADIUS_NM=1000
SKYTRACE_OPENSKY_DAILY_BUDGET=3000
SKYTRACE_OPENSKY_MIN_INTERVAL_SECONDS=5
