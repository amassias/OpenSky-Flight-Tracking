# OpenSky Network API Credentials
# Get your credentials at: https://opensky-network.org/
OPEN_SKY_CLIENT_ID=your_client_id_here
OPEN_SKY_CLIENT_SECRET=your_client_secret_here

# Optional on-demand route enrichment for selected live aircraft.
SKYTRACE_ROUTE_LOOKUP_ENABLED=1
SKYTRACE_ROUTE_TIMEOUT_SECONDS=4
SKYTRACE_ROUTE_CACHE_SECONDS=300

# Live map provider tuning. The client reuses a viewport briefly to avoid
# rate-limit bursts; the radius expands with the visible map when zooming out.
SKYTRACE_LIVE_CACHE_SECONDS=15
SKYTRACE_LIVE_STALE_SECONDS=90
SKYTRACE_LIVE_MAX_RADIUS_NM=1000
